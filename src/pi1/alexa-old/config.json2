{
  "FAUXMO": {
    "ip_address": "auto"
  },
  "PLUGINS": {
    "CommandLinePlugin": {
      "path": "/var/www/alexa/src/fauxmo/plugins/commandlineplugin.py",
      "DEVICES": [
        {
            "name": "one",
            "port": 49001,
            "on_cmd": "/usr/bin/curl 'http://10.0.0.4/index.php?sw1=on';touch gpio_1.txt",
            "off_cmd": "/usr/bin/curl 'http://10.0.0.4/index.php?sw1=off';rm gpio_1.txt",
            "state_cmd": "ls gpio_1.txt"
        },
