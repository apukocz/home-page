#! /bin/sh
#
#

GPIO_DIR=/var/www/gpio
PATH_GPIO=/var/www/gpio
DIR="/sys/class/gpio"
GPIO=/sys/devices/platform/gpio-sunxi/gpio
ECHO=/bin/echo


case "$1" in
  start)

# Relay
VALUE=535 # 23
echo ${VALUE} > $DIR/export
echo out > $DIR/gpio${VALUE}/direction
echo 1 > $DIR/gpio${VALUE}/value
chmod 777 $DIR/gpio${VALUE}/value
rm ${GPIO_DIR}/gpio${VALUE}
ln -s $DIR/gpio${VALUE}/value ${GPIO_DIR}/gpio${VALUE} # 23 Pin 23 staje się pinem ${VALUE} (512 + 23)

VALUE=526 # 14
echo ${VALUE} > $DIR/export
echo out > $DIR/gpio${VALUE}/direction
echo 1 > $DIR/gpio${VALUE}/value
chmod 777 $DIR/gpio${VALUE}/value
rm ${GPIO_DIR}/gpio${VALUE}
ln -s $DIR/gpio${VALUE}/value ${GPIO_DIR}/gpio${VALUE} # 14 Pin 14 staje się pinem ${VALUE} (512 + 14)

VALUE=527 # 15
echo ${VALUE} > $DIR/export
echo out > $DIR/gpio${VALUE}/direction
echo 1 > $DIR/gpio${VALUE}/value
chmod 777 $DIR/gpio${VALUE}/value
rm ${GPIO_DIR}/gpio${VALUE}
ln -s $DIR/gpio${VALUE}/value ${GPIO_DIR}/gpio${VALUE} # 15 Pin 15 staje się pinem ${VALUE} (512 + 15)

VALUE=530 # 18
echo ${VALUE} > $DIR/export
echo out > $DIR/gpio${VALUE}/direction
echo 1 > $DIR/gpio${VALUE}/value
chmod 777 $DIR/gpio${VALUE}/value
rm ${GPIO_DIR}/gpio${VALUE}
ln -s $DIR/gpio${VALUE}/value ${GPIO_DIR}/gpio${VALUE} # 18 Pin 18 staje się pinem ${VALUE} (512 + 18)


#i2c

I2CSET=/usr/sbin/i2cset
PCA9685_BUS=1

CONF_ADDRESS1=0x40
CONF_ADDRESS2=0x41

# i2c Setup
${I2CSET} -y 1 0x40 0 0x00
${I2CSET} -y 1 0x40 0 16
${I2CSET} -y 1 0x40 254 101
${I2CSET} -y 1 0x40 0 0x00

${I2CSET} -y 1 0x41 0 0x00
${I2CSET} -y 1 0x41 0 16
${I2CSET} -y 1 0x41 254 101
${I2CSET} -y 1 0x41 0 0x00

# restart
#${I2CSET} -y ${PCA9685_BUS} ${CONF_ADDRESS1} 0x01 0x91
#${I2CSET} -y ${PCA9685_BUS} ${CONF_ADDRESS2} 0x01 0x91

# set output logic as inverted
${I2CSET} -y ${PCA9685_BUS} ${CONF_ADDRESS1} 0x01 0x10
${I2CSET} -y ${PCA9685_BUS} ${CONF_ADDRESS2} 0x01 0x10

# change to normal mode
#${I2CSET} -y ${PCA9685_BUS} ${CONF_ADDRESS1} 0x01 0x01
#${I2CSET} -y ${PCA9685_BUS} ${CONF_ADDRESS2} 0x01 0x01

# set perm
chmod 777 /dev/i2c-1
chmod 755 /sys/class/gpio
chmod 755 /sys/class/gpio/gpio526
chmod 755 /sys/class/gpio/gpio527
chmod 755 /sys/class/gpio/gpio530
chmod 755 /sys/class/gpio/gpio535
chmod 666 /sys/class/gpio/gpio526/value
chmod 666 /sys/class/gpio/gpio527/value
chmod 666 /sys/class/gpio/gpio530/value
chmod 666 /sys/class/gpio/gpio535/value
    ;;
  stop)
    echo "No Stopping "
    ;;
  *)
    echo "Usage: /etc/init.d/raspberry {start|stop}"
    exit 1
    ;;
esac

exit 0
